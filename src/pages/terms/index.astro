---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const pageTitle = "Terms of Use: Educational Disclaimer & Service Terms";
const pageDescription = "Fintools Find's Terms of Use: Legal guidelines, educational estimation disclaimers, intellectual property policies, and terms of service.";
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fintool.org';
const canonicalUrl = `${siteOrigin}/terms/`;

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={termsSchema}>
  <div class="max-w-[1000px] mx-auto px-4 md:px-8 py-12">
    <Breadcrumbs items={[{ name: 'Terms of Use' }]} />

    <header class="mb-12 border-b border-hairline pb-8">
      <h1 class="text-3xl md:text-5xl font-bold text-ink tracking-tight mb-4">Terms of Use</h1>
      <p class="text-lg md:text-xl text-body max-w-3xl leading-relaxed">
        Last Updated: August 6, 2026. Please review these terms governing your access to Fintools Find financial calculators and educational guides.
      </p>
    </header>

    <div class="space-y-10 text-body leading-relaxed text-base md:text-lg">
      <section class="p-8 bg-surface-soft border border-hairline rounded-2xl">
        <h2 class="text-2xl font-bold text-ink mb-4">1. Educational & Estimation Disclaimer</h2>
        <p class="mb-4">
          All 194 calculators, mathematical engines, amortization schedules, tax estimates, and financial guides published on Fintools Find are provided strictly for <strong>educational, illustrative, and informational purposes</strong>.
        </p>
        <p>
          Fintools Find is not a registered investment advisor, certified financial planner (CFP), certified public accountant (CPA), or licensed lender. Computational outputs do not constitute formal financial, investment, tax, legal, or mortgage advice. For binding financial decisions, consult a qualified professional. See our full <a href="/disclaimer/" class="text-primary hover:underline font-semibold">Financial Disclaimer</a>.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ink mb-4">2. Permitted Use & Fair Access</h2>
        <p class="mb-4">
          You are granted a non-exclusive, revocable license to access and use Fintools Find calculators for personal, commercial, or educational planning.
        </p>
        <p class="mb-4">You agree not to:</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>Automate unauthorized web-scraping or denial-of-service traffic against Fintools Find infrastructure.</li>
          <li>Frame or mirror Fintools Find pages without explicit attribution.</li>
          <li>Misrepresent computational estimates generated by Fintools Find as guaranteed financial commitments from banks or tax authorities.</li>
        </ul>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">3. Intellectual Property Rights</h2>
        <p class="mb-4">
          The software code, design system, layout, mathematical algorithms, client-side widgets, content guides, and brand trademarks associated with Fintools Find are protected by intellectual property laws.
        </p>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">4. Limitation of Liability</h2>
        <p class="mb-4">
          In no event shall Fintools Find, its engineers, quant authors, or affiliates be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use our tools, or reliance upon computational estimates.
        </p>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">5. Governing Law & Modifications</h2>
        <p class="mb-4">
          These Terms shall be governed by applicable laws. Fintools Find reserves the right to modify these Terms of Use at any time. Continued use of the platform constitutes acceptance of updated terms.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
