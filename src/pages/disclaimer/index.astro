---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const pageTitle = "Financial & Legal Disclaimer";
const pageDescription = "Fintools Find's Financial Disclaimer: Important legal notices regarding estimation accuracy, non-binding calculations, and professional advice recommendations.";
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fintool.org';
const canonicalUrl = `${siteOrigin}/disclaimer/`;

const disclaimerSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} schema={disclaimerSchema}>
  <div class="max-w-[1000px] mx-auto px-4 md:px-8 py-12">
    <Breadcrumbs items={[{ name: 'Financial Disclaimer' }]} />

    <header class="mb-12 border-b border-hairline pb-8">
      <h1 class="text-3xl md:text-5xl font-bold text-ink tracking-tight mb-4">Financial & Legal Disclaimer</h1>
      <p class="text-lg md:text-xl text-body max-w-3xl leading-relaxed">
        Please read this financial disclaimer carefully before utilizing any calculator, tool, or guide on Fintools Find.
      </p>
    </header>

    <div class="space-y-10 text-body leading-relaxed text-base md:text-lg">
      <section class="p-8 bg-accent-amber/10 border border-accent-amber/30 rounded-2xl">
        <h2 class="text-2xl font-bold text-ink mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-accent-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          General Educational Notice
        </h2>
        <p class="mb-2">
          Fintools Find is an independent digital publisher providing financial calculators, mathematical tools, and educational materials.
        </p>
        <p>
          All 194 planned calculators and guides published on Fintools Find are designed strictly for <strong>educational and illustrative purposes</strong>. Fintools Find is not a registered financial advisor, wealth manager, mortgage broker, licensed accountant, or tax preparation service.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-ink mb-4">1. No Financial or Investment Advice</h2>
        <p class="mb-4">
          Calculations generated by our SIP, CAGR, SWP, 401(k), NPS, or FIRE tools rely on user-supplied assumptions regarding future investment return rates and inflation. Past performance and mathematical projections do not guarantee future investment returns.
        </p>
        <p>
          Do not make binding investment, asset allocation, or portfolio liquidation decisions based solely on Fintools Find outputs. Always consult a licensed Certified Financial Planner (CFP) or Registered Investment Advisor (RIA).
        </p>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">2. Tax Computation Estimates</h2>
        <p class="mb-4">
          Income Tax, GST, VAT, TDS, HRA, and Gratuity estimates execute published statutory equations (CBDT, IRS, PFRDA). However, actual individual tax liability depends on your total gross income, filing status, local state surcharges, cess, and individual deduction eligibility.
        </p>
        <p>
          Fintools Find does not substitute for official tax preparation software or advice from a Certified Public Accountant (CPA) or Chartered Accountant (CA).
        </p>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">3. Banking & Loan Amortization Estimates</h2>
        <p class="mb-4">
          Loan EMI, Eligibility, Amortization, and Prepayment outputs are estimates based on standard compounding math. Actual loan terms offered by financial institutions (banks, credit unions, non-banking financial companies) depend on credit score checks, processing fees, loan origin costs, property appraisals, and underwriting guidelines.
        </p>
      </section>

      <section class="border-t border-hairline pt-8">
        <h2 class="text-2xl font-bold text-ink mb-4">4. No Warranty</h2>
        <p class="mb-4">
          While we strive for institutional precision across every line of code, Fintools Find provides all calculators "as is" without warranty of any kind, express or implied.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
