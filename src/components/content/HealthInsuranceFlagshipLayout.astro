---
import FlagshipLayout from './FlagshipLayout.astro';
import HealthInsuranceCalculatorWidget from '../calculators/HealthInsuranceCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Select Household & Location Profile',
    description: 'Select your city tier baseline and family member composition (self, spouse, children, senior citizen parents).',
  },
  {
    stepNumber: '02',
    title: 'Input Employer Cover & Inflation Rate',
    description: 'Enter existing corporate group health insurance and set expected medical inflation (default 12% p.a.).',
  },
  {
    stepNumber: '03',
    title: 'Review Coverage Gap & Tax Savings',
    description: 'Evaluate recommended sum insured, additional coverage gap, base + super top-up split, and Section 80D tax deductions.',
  },
];

const benchmarkCaseStudies = [
  {
    persona: 'Young Single Professional',
    scenario: '25 Yrs | Tier-1 Metro | Employer Cover = ₹3 Lakhs | 5-Year Medical Inflation @ 12%',
    recommendation: 'Recommended Health Cover = ₹18 Lakhs | Retail Coverage Gap = ₹15 Lakhs | Retail retail top-up avoids corporate dependence.',
  },
  {
    persona: 'Nuclear Family (Couple + 1 Child)',
    scenario: '35 Yrs | Tier-1 Metro | Employer Cover = ₹5 Lakhs | Family Floater Base + Top-Up',
    recommendation: 'Recommended Sum Insured = ₹23 Lakhs | Strategy: ₹5L Base Policy + ₹18L Super Top-Up (Save ~₹4,500/yr in premium).',
  },
  {
    persona: 'Family with Senior Citizen Parents',
    scenario: '35 Yrs + Senior Parents (62 Yrs) | Old Tax Regime 30% Slab | Max Section 80D',
    recommendation: 'Recommended Cover = ₹35 Lakhs | Section 80D Tax Savings = ₹22,500/yr (₹25k self + ₹50k senior parents deduction).',
  },
];
---

<FlagshipLayout data={data} slug={slug}>
  <HealthInsuranceCalculatorWidget client:load />

  {/* Educational Guidance Section */}
  <section class="mt-12 space-y-8 border-t border-hairline pt-8">
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
        How to Determine Family Health Insurance Sum Insured
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        Healthcare costs in urban hospitals compound at 12-15% annually—more than double general retail inflation. Evaluating recommended sum insured, employer policy gaps, room rent caps, and Section 80D tax savings ensures financial protection against critical medical emergencies.
      </p>
    </div>

    {/* 3-Step Process Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {timelineSteps.map((step) => (
        <div class="p-6 bg-canvas border border-hairline rounded-2xl space-y-3 shadow-soft">
          <span class="text-xs font-mono font-black px-2.5 py-1 bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 rounded-md inline-block">
            Step {step.stepNumber}
          </span>
          <h3 class="text-base font-bold text-ink">{step.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    {/* Benchmark Case Studies */}
    <div class="space-y-4 pt-6 border-t border-hairline">
      <h3 class="text-lg font-bold text-ink">
        Illustrative Health Coverage Benchmark Case Studies
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benchmarkCaseStudies.map((cs) => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-2">
            <span class="text-xs font-bold text-rose-600 block">{cs.persona}</span>
            <p class="text-xs font-semibold text-ink">{cs.scenario}</p>
            <p class="text-xs text-muted leading-relaxed">{cs.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</FlagshipLayout>
