---
import FlagshipLayout from './FlagshipLayout.astro';
import CapRateCalculatorWidget from '../calculators/CapRateCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Enter Property Value & Gross Rent',
    description: 'Input the property purchase price or estimated market value, monthly gross rent, and expected tenant vacancy allowance.',
  },
  {
    stepNumber: '02',
    title: 'Itemize Property Operating Expenses',
    description: 'Specify annual property taxes, insurance, repairs & maintenance, property management fee %, and society charges to calculate Net Operating Income (NOI).',
  },
  {
    stepNumber: '03',
    title: 'Benchmark Target Cap Rate & Valuation',
    description: 'Compare your property Cap Rate against market target yields, mortgage interest rates, and implied target valuation.',
  },
];

const benchmarkCaseStudies = [
  {
    persona: 'Single-Family Residential Rental',
    scenario: '₹50 Lakhs Property | Rent = ₹30,000 / mo | 5% Vacancy | OpEx = ₹90,000',
    recommendation: 'Annual NOI = ₹2,52,000 | Cap Rate = 5.04% | OpEx Ratio = 26.3%. Stable residential income with capital growth potential.',
  },
  {
    persona: 'Commercial Retail Unit',
    scenario: '₹2.00 Crore Property | Rent = ₹1,40,000 / mo | 4% Vacancy | OpEx = ₹3,20,000',
    recommendation: 'Annual NOI = ₹13,33,600 | Cap Rate = 6.67% | OpEx Ratio = 19.3%. Higher yield commercial asset with strong tenant lease terms.',
  },
  {
    persona: 'Multi-Family Apartment Complex',
    scenario: '₹5.00 Crore Property | Rent = ₹3,80,000 / mo | 6% Vacancy | OpEx = ₹9,00,000',
    recommendation: 'Annual NOI = ₹33,83,200 | Cap Rate = 6.77% | Implied Valuation at 7.0% Cap = ₹4.83 Crores.',
  },
];
---

<FlagshipLayout data={data} slug={slug}>
  <CapRateCalculatorWidget client:load />

  {/* Educational Guidance Section */}
  <section class="mt-12 space-y-8 border-t border-hairline pt-8">
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
        Understanding Capitalization Rate (Cap Rate) & Real Estate Valuation
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        The Capitalization Rate (Cap Rate) measures the unleveraged rate of return generated by an income-producing property relative to its purchase price or market value. It serves as a fundamental benchmark for real estate valuation, risk assessment, and market comparisons.
      </p>
    </div>

    {/* 3-Step Process Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {timelineSteps.map((step) => (
        <div class="p-6 bg-canvas border border-hairline rounded-2xl space-y-3 shadow-soft">
          <span class="text-xs font-mono font-black px-2.5 py-1 bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 rounded-md inline-block">
            Step {step.stepNumber}
          </span>
          <h3 class="text-base font-bold text-ink">{step.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    {/* Benchmark Case Studies */}
    <div class="space-y-4 pt-6 border-t border-hairline">
      <h3 class="text-lg font-bold text-ink">
        Illustrative Real Estate Cap Rate Benchmarks
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benchmarkCaseStudies.map((cs) => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-2">
            <span class="text-xs font-bold text-sky-600 block">{cs.persona}</span>
            <p class="text-xs font-semibold text-ink">{cs.scenario}</p>
            <p class="text-xs text-muted leading-relaxed">{cs.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</FlagshipLayout>
