---
import FlagshipLayout from './FlagshipLayout.astro';
import CtcCalculatorWidget from '../calculators/CtcCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Enter Annual CTC & Basic %',
    description: 'Input your total annual Cost to Company (CTC) package and basic salary allocation (default 50%).',
  },
  {
    stepNumber: '02',
    title: 'Input Rent & Bonus Details',
    description: 'Provide monthly rent paid for Old Regime HRA exemption and annual variable/performance bonus included in CTC.',
  },
  {
    stepNumber: '03',
    title: 'Compare Old vs New Tax Regimes',
    description: 'Evaluate gross monthly cash salary, statutory EPF/PT deductions, annual TDS, and net monthly in-hand take-home.',
  },
];

const benchmarkCaseStudies = [
  {
    persona: 'Entry-Level Graduate',
    scenario: '₹6 LPA CTC | 50% Basic | Rent = ₹12,000/mo | New Tax Regime',
    recommendation: 'Gross Monthly = ₹46,150 | Employee EPF = ₹3,000/mo | Net Take-Home = ~₹42,900/month.',
  },
  {
    persona: 'Mid-Career Corporate Professional',
    scenario: '₹18 LPA CTC | 50% Basic | Rent = ₹25,000/mo | HRA Exemption = ₹1.8L',
    recommendation: 'Gross Monthly = ₹1,38,000 | Old Regime HRA saves ~₹54,000/yr in tax compared to New Regime.',
  },
  {
    persona: 'Senior Executive / Tech Leader',
    scenario: '₹45 LPA CTC | ₹5L Bonus | Rent = ₹40,000/mo | New Tax Regime',
    recommendation: 'Gross Monthly = ₹3,45,000 | Employer Retainers = ~₹3.8L/yr | Net Take-Home = ~₹2,42,000/month.',
  },
];
---

<FlagshipLayout data={data} slug={slug}>
  <CtcCalculatorWidget client:load />

  {/* Educational Guidance Section */}
  <section class="mt-12 space-y-8 border-t border-hairline pt-8">
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
        Understanding Your Cost to Company (CTC) vs In-Hand Take-Home Salary
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        Cost to Company (CTC) represents the total annual expenditure an employer incurs on an employee. A significant portion of CTC is retained in employer contributions (Employer EPF, Gratuity, Health Cover) and variable performance bonus before calculating gross cash salary and net monthly take-home.
      </p>
    </div>

    {/* 3-Step Process Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {timelineSteps.map((step) => (
        <div class="p-6 bg-canvas border border-hairline rounded-2xl space-y-3 shadow-soft">
          <span class="text-xs font-mono font-black px-2.5 py-1 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 rounded-md inline-block">
            Step {step.stepNumber}
          </span>
          <h3 class="text-base font-bold text-ink">{step.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    {/* Benchmark Case Studies */}
    <div class="space-y-4 pt-6 border-t border-hairline">
      <h3 class="text-lg font-bold text-ink">
        Illustrative CTC Breakdown Scenarios
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benchmarkCaseStudies.map((cs) => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-2">
            <span class="text-xs font-bold text-emerald-600 block">{cs.persona}</span>
            <p class="text-xs font-semibold text-ink">{cs.scenario}</p>
            <p class="text-xs text-muted leading-relaxed">{cs.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</FlagshipLayout>
