---
import ToolLayout from '../ToolLayout.astro';
import DefinitionCard from '../ui/DefinitionCard.astro';
import FAQAccordion from '../ui/FAQAccordion';
import RelatedContentGrid from '../ui/RelatedContentGrid.astro';
import ExploreMoreTools from '../ui/ExploreMoreTools.astro';
import { getRelatedContent } from '@utils/getRelatedContent.js';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;
const canonicalUrl = `https://fintool.find/glossary/${slug}/`;

const relatedData = await getRelatedContent({
  type: 'glossary',
  slug,
  category: data.category,
  limit: 4,
});

const definedTermSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.title,
  description: data.shortDefinition,
  inDefinedTermSet: 'https://fintool.find/glossary/',
  url: canonicalUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fintool.find/' },
    { '@type': 'ListItem', position: 2, name: 'Financial Glossary', item: 'https://fintool.find/glossary/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
  ],
};

const faqSchema = data.faqs && data.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((faq: any) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;
---

<ToolLayout
  title={data.seoTitle || `${data.title} Definition & Financial Meaning | Fintools Find`}
  metaDescription={data.seoDescription || data.shortDefinition}
  category={data.category}
  categoryName="Financial Glossary"
  slug={slug}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(definedTermSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-10">
    {/* 1. HERO & DEFINITION CARD */}
    <DefinitionCard
      term={data.title}
      shortDefinition={data.shortDefinition}
      category={data.category}
      synonyms={data.synonyms}
    />

    {/* 2. REAL-WORLD EXAMPLES BOX */}
    {data.examples && data.examples.length > 0 && (
      <div class="p-6 sm:p-8 rounded-3xl bg-emerald-500/5 border border-emerald-500/20 space-y-3 shadow-soft">
        <div class="flex items-center gap-2 text-emerald-600 font-heading font-extrabold text-base">
          <span>💡</span>
          <h3>Real-World Example</h3>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-body">
          {data.examples.map((ex: string) => (
            <li class="flex items-start gap-2 bg-canvas/80 p-3 rounded-2xl border border-hairline/60">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{ex}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* 3. MATHEMATICAL FORMULAS BOX */}
    {data.formulas && data.formulas.length > 0 && (
      <div class="p-6 sm:p-8 rounded-3xl bg-surface-strong border border-hairline space-y-3 shadow-soft font-mono">
        <div class="flex items-center gap-2 text-primary font-bold text-sm">
          <span>🧮</span>
          <span>Standard Financial Formula</span>
        </div>
        {data.formulas.map((f: string) => (
          <div class="p-4 bg-canvas border border-hairline rounded-2xl text-xs text-ink font-bold overflow-x-auto">
            {f}
          </div>
        ))}
      </div>
    )}

    {/* 4. MAIN ARTICLE BODY */}
    <article class="prose prose-slate max-w-none bg-canvas border border-hairline rounded-3xl p-6 sm:p-10 shadow-soft text-body space-y-6">
      <slot />
    </article>

    {/* 5. COMMON MISTAKES CALLOUT */}
    {data.commonMistakes && data.commonMistakes.length > 0 && (
      <div class="p-6 sm:p-8 rounded-3xl bg-rose-500/5 border border-rose-500/20 space-y-3 shadow-soft">
        <div class="flex items-center gap-2 text-semantic-danger font-heading font-extrabold text-base">
          <span>⚠️</span>
          <h3>Common Mistakes to Avoid</h3>
        </div>
        <ul class="space-y-2 text-xs sm:text-sm text-body">
          {data.commonMistakes.map((m: string) => (
            <li class="flex items-start gap-2 bg-canvas/80 p-3 rounded-2xl border border-hairline/60">
              <span class="text-semantic-danger font-bold">✕</span>
              <span>{m}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* 6. FAQ ACCORDION */}
    {data.faqs && data.faqs.length > 0 && (
      <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-soft">
        <h3 class="text-xl font-bold font-heading text-ink">Frequently Asked Questions</h3>
        <FAQAccordion faqs={data.faqs} client:visible />
      </div>
    )}

    {/* 7. INTELLIGENT KNOWLEDGE GRAPH RECOMMENDATIONS */}
    <RelatedContentGrid content={relatedData} />

    {/* 8. EXPLORE MORE SILOS (ZERO DEAD ENDS) */}
    <ExploreMoreTools category={data.category} />
  </div>
</ToolLayout>
