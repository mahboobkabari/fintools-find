---
import FlagshipLayout from './FlagshipLayout.astro';
import RdCalculatorWidget from '../calculators/RdCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Enter Monthly Installment & Select Deposit Tenure',
    description: 'Specify your fixed monthly contribution amount and target tenure in years or months.',
  },
  {
    stepNumber: '02',
    title: 'Set Interest Rate & Audit Senior Citizen Bonus',
    description: 'Enter your bank RD interest rate and toggle Senior Citizen status for an instant +0.50% p.a. rate boost.',
  },
  {
    stepNumber: '03',
    title: 'Audit Section 194A Statutory TDS Tax Deductions',
    description: 'Review statutory TDS threshold limits (₹40,000 general / ₹50,000 senior citizen cap) and verify 10% vs 20% PAN rates.',
  },
  {
    stepNumber: '04',
    title: 'Compare Guaranteed Bank RD vs. Market Equity SIP',
    description: 'Evaluate 100% capital guaranteed RD maturity returns against projected market-linked mutual fund SIP wealth.',
    colorClass: 'text-semantic-success',
  },
];

const targetPersonas = [
  {
    title: 'Disciplined Monthly Savers',
    description: 'Individuals setting aside a fixed portion of monthly salary into zero-risk guaranteed bank recurring deposits.',
    bgClass: 'bg-blue-50',
    textClass: 'text-primary',
  },
  {
    title: 'Senior Citizen Investors',
    description: 'Retirees leveraging the +0.50% rate bonus and higher ₹50,000 Section 194A TDS exemption threshold.',
    bgClass: 'bg-amber-50',
    textClass: 'text-amber-600',
  },
  {
    title: 'Short-to-Medium Goal Accumulators',
    description: 'Savers accumulating lump-sum funds for annual insurance premiums, vacation funds, or gadget purchases.',
    bgClass: 'bg-emerald-50',
    textClass: 'text-semantic-success',
  },
  {
    title: 'Conservative Wealth Allocators',
    description: 'Investors balancing high-risk equity portfolios with guaranteed fixed-income recurring bank deposits.',
    bgClass: 'bg-purple-50',
    textClass: 'text-purple-600',
  },
];

const formulaDetails = {
  title: 'Recurring Deposit Quarterly Compounding & TDS Formulas',
  formula: 'A = \\sum_{m=1}^{n} P \\left(1 + \\frac{r/100}{4}\\right)^{(n - m + 1)/3}, \\quad \\text{TDS} = \\begin{cases} \\text{Interest} \\times 10\\%, & \\text{if Interest} > \\text{Threshold} \\text{ (with PAN)} \\\\ \\text{Interest} \\times 20\\%, & \\text{if Interest} > \\text{Threshold} \\text{ (without PAN)} \\end{cases}',
  parameters: [
    {
      symbol: 'P',
      title: 'Monthly Installment Amount',
      description: 'Equal deposit amount contributed at the beginning of each month.',
      colorClass: 'text-primary',
    },
    {
      symbol: 'r',
      title: 'Annual Interest Rate (% p.a.)',
      description: 'Base bank RD rate (+0.50% for senior citizens).',
      colorClass: 'text-accent-amber',
    },
    {
      symbol: 'n',
      title: 'Total Tenure in Months',
      description: 'Total number of monthly installments deposited ($n = \\text{Years} \\times 12$).',
      colorClass: 'text-blue-600',
    },
    {
      symbol: '\\text{Threshold}',
      title: 'Section 194A TDS Limit',
      description: 'Statutory threshold (₹40,000 for general public / ₹50,000 for senior citizens).',
      colorClass: 'text-semantic-warning',
    },
  ],
};

const caseStudies = [
  {
    title: 'Benchmark Case Study: ₹10,000 Monthly Installment (1-Year @ 7.0% p.a.)',
    tag: 'Standard 1-Year RD',
    subtitle: 'Quarterly Compounding Monthly Accumulation',
    metrics: [
      { label: 'Monthly Installment', value: '₹10,000/mo', colorClass: 'text-primary font-bold' },
      { label: 'Total Installments Paid', value: '₹120,000', colorClass: 'text-blue-600 font-bold' },
      { label: 'Guaranteed Interest', value: '₹4,621', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Maturity Value', value: '₹124,621', colorClass: 'text-emerald-600 font-bold' },
    ],
    takeaway: 'Quarterly compounding on monthly installments generates ₹4,621 in guaranteed fixed interest on a total deposit of ₹1,20,000 over 12 months.',
  },
  {
    title: 'Benchmark Case Study: ₹20,000 Monthly Installment (3-Year Senior Citizen @ 7.5% p.a.)',
    tag: 'Senior Citizen 3-Year RD',
    subtitle: 'Maximized Interest Yield with Senior Bonus',
    metrics: [
      { label: 'Monthly Installment', value: '₹20,000/mo', colorClass: 'text-primary font-bold' },
      { label: 'Effective Rate', value: '7.50% p.a.', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Total Installments Paid', value: '₹720,000', colorClass: 'text-blue-600 font-bold' },
      { label: 'Guaranteed Maturity Value', value: '₹808,655', colorClass: 'text-emerald-600 font-bold' },
    ],
    takeaway: 'Senior citizen bonus (+0.50%) yields ₹88,655 in total interest on ₹7.2 Lakhs deposited, while Section 194A TDS is capped at the higher ₹50,000 senior threshold.',
  },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
>
  <RdCalculatorWidget slot="calculator" client:visible />
</FlagshipLayout>
