---
import FlagshipLayout from './FlagshipLayout.astro';
import StepUpSipCalculatorWidget from '../calculators/StepUpSipCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Starting SIP & Financial Goal Definition',
    description: 'Set your initial monthly SIP contribution or target wealth goal (e.g. ₹1 Crore for retirement or buying a home).',
  },
  {
    stepNumber: '02',
    title: 'Salary-Indexed Annual Step-Up Setup',
    description: 'Commit to stepping up your monthly contribution by 5%, 10%, or 15% every year in alignment with your annual salary increments.',
  },
  {
    stepNumber: '03',
    title: 'Compounding Acceleration Phase',
    description: 'As your monthly SIP contribution grows annually, total returns accelerate exponentially, shortening the time required to reach your target goal.',
  },
  {
    stepNumber: '04',
    title: 'Inflation-Adjusted Real Wealth Harvest',
    description: 'Harvest your final accumulated corpus, evaluating both nominal wealth growth and real inflation-adjusted purchasing power.',
    colorClass: 'text-semantic-success',
  },
];

const targetPersonas = [
  {
    title: 'Young Professionals & Career Starters',
    description: 'Starting with a lower initial monthly SIP and stepping up contributions annually as career earnings and promotions increase.',
    bgClass: 'bg-blue-50',
    textClass: 'text-primary',
  },
  {
    title: 'Goal-Based Investors',
    description: 'Targeting specific milestones like a ₹1 Crore home down payment or child higher education fund within 10 to 20-year horizons.',
    bgClass: 'bg-emerald-50',
    textClass: 'text-semantic-success',
  },
  {
    title: 'FIRE & Wealth Accumulators',
    description: 'Aggressively stepping up contributions by 15% annually to build a multi-crore early retirement nest egg faster.',
    bgClass: 'bg-sky-50',
    textClass: 'text-accent-sky',
  },
  {
    title: 'Salaried Employees with Annual Hikes',
    description: 'Automating annual SIP top-ups with annual appraisal raises to prevent lifestyle inflation from eroding savings potential.',
    bgClass: 'bg-amber-50',
    textClass: 'text-semantic-warning',
  },
];

const formulaDetails = {
  title: 'Step-Up Monthly Compounding & Escalation Formula',
  formula: 'B_m = \\left( B_{m-1} + W_y \\right) \\times \\left(1 + \\frac{R}{12 \\times 100}\\right), \\quad W_y = W_0 \\times (1 + g)^{y-1}',
  parameters: [
    {
      symbol: 'W_0',
      title: 'Initial Monthly SIP Contribution',
      description: 'Starting monthly investment amount in Year 1.',
      colorClass: 'text-primary',
    },
    {
      symbol: 'g',
      title: 'Annual Step-Up Percentage Rate',
      description: 'Annual percentage increase in monthly contribution (% p.a.).',
      colorClass: 'text-accent-amber',
    },
    {
      symbol: 'W_y',
      title: 'Monthly SIP in Year y',
      description: 'Escalated monthly contribution during year y.',
      colorClass: 'text-purple-600',
    },
    {
      symbol: 'B_m',
      title: 'Compounded Portfolio Balance',
      description: 'Accumulated portfolio wealth at the end of month m.',
      colorClass: 'text-semantic-success',
    },
  ],
};

const caseStudies = [
  {
    title: 'Career Starter Case Study: ₹10,000/mo SIP (10% Step-Up, 12% Return over 15 Years)',
    tag: 'Wealth Multiplier',
    subtitle: 'Standard Step-Up Plan',
    metrics: [
      { label: 'Starting Monthly SIP', value: '₹10,000 / mo', colorClass: 'text-primary font-bold' },
      { label: 'Final Monthly SIP (Year 15)', value: '₹37,975 / mo', colorClass: 'text-amber-600 font-bold' },
      { label: 'Total Capital Invested', value: '₹38.12 Lakhs' },
      { label: 'Projected Maturity Corpus', value: '₹95.96 Lakhs', colorClass: 'text-semantic-success font-bold' },
    ],
    takeaway: 'Stepping up a ₹10,000/mo SIP by 10% annually yields ₹95.96 Lakhs over 15 years—more than double the ₹47.5 Lakhs generated by a static ₹10,000/mo fixed SIP!',
  },
  {
    title: 'FIRE Goal Solver: ₹1.0 Crore Target in 15 Years (10% Step-Up vs. Fixed SIP)',
    tag: 'Goal Solver',
    subtitle: 'Starting Burden Reduction',
    metrics: [
      { label: 'Target Wealth Goal', value: '₹1.00 Crore', colorClass: 'text-primary font-bold' },
      { label: 'Required Starting Fixed SIP (0% Step-Up)', value: '₹20,017 / mo', colorClass: 'text-rose-600 font-bold' },
      { label: 'Required Starting Step-Up SIP (10% Step-Up)', value: '₹10,421 / mo', colorClass: 'text-semantic-success font-bold' },
      { label: 'Starting Monthly Savings Advantage', value: '₹9,596 / mo Less', colorClass: 'text-semantic-success font-bold' },
    ],
    takeaway: 'Committed to a 10% annual step-up allows you to start your ₹1 Crore goal journey with almost 50% lower initial monthly investment (₹10,421/mo vs ₹20,017/mo fixed SIP).',
  },
];

const comparisonData = {
  title: 'Step-Up SIP vs. Static Fixed Monthly SIP',
  subtitle: 'Comparing initial affordability, long-term capital accumulation, and goal achievement speed',
  optionA: {
    badge: 'DYNAMIC & SALARY-INDEXED',
    title: 'Step-Up SIP (Annual Top-Up)',
    items: [
      { isPositive: true, text: 'Lower Starting Commitment: Allows you to begin goal investing with significantly lower initial monthly SIP.' },
      { isPositive: true, text: 'Exponential Corpus Growth: Compounding accelerates rapidly as annual contribution increases.' },
      { isPositive: true, text: 'Beats Lifestyle Inflation: Automatically routes salary raises into wealth accumulation.' },
    ],
  },
  optionB: {
    badge: 'STATIC & RIGID',
    title: 'Fixed Monthly SIP (0% Increase)',
    items: [
      { isPositive: false, text: 'Higher Initial Burden: Requires a much higher starting monthly SIP to reach the same target goal.' },
      { isPositive: false, text: 'Under-utilized Savings Power: Leaves salary raises uninvested in low-yielding savings accounts.' },
      { isPositive: false, text: 'Erosion by Inflation: Fixed contribution loses real purchasing power over 15–20 year horizons.' },
    ],
  },
};
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
  comparisonData={comparisonData}
>
  <StepUpSipCalculatorWidget client:visible />
</FlagshipLayout>
