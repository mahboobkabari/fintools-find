---
import ToolLayout from '../ToolLayout.astro';
import ReadingProgress from '../ui/ReadingProgress';
import AuthorCard from '../ui/AuthorCard.astro';
import KeyTakeaways from '../ui/KeyTakeaways.astro';
import GuideCTA from '../ui/GuideCTA.astro';
import FAQAccordion from '../ui/FAQAccordion';
import RelatedContentGrid from '../ui/RelatedContentGrid.astro';
import ExploreMoreTools from '../ui/ExploreMoreTools.astro';
import { getRelatedContent } from '@utils/getRelatedContent.js';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;
const canonicalUrl = `https://fintool.find/guides/${slug}/`;

const relatedData = await getRelatedContent({
  type: 'guide',
  slug,
  category: data.category,
  limit: 4,
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.seoTitle || data.title,
  description: data.seoDescription || data.metaDescription,
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Organization',
    name: data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fintools Find',
  },
  datePublished: data.publishDate?.toISOString() || new Date().toISOString(),
  dateModified: data.updatedDate?.toISOString() || data.publishDate?.toISOString() || new Date().toISOString(),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fintool.find/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://fintool.find/guides/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
  ],
};

const faqSchema = data.faqs && data.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((faq: any) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;
---

<ToolLayout
  title={data.seoTitle || data.title}
  metaDescription={data.seoDescription || data.metaDescription}
  category={data.category}
  categoryName="Financial Education"
  slug={slug}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  {/* Client-side Reading Progress Bar */}
  <ReadingProgress client:idle />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-10">
    {/* 1. HERO HEADER */}
    <header class="space-y-4 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-pill bg-surface-strong border border-hairline text-xs font-mono text-muted">
        <span>📖</span>
        <span class="uppercase tracking-wider">Financial Education Guide</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-ink leading-tight">
        {data.title}
      </h1>
      <p class="text-sm sm:text-base text-body leading-relaxed">
        {data.metaDescription}
      </p>
    </header>

    {/* 2. EEAT AUTHOR & REVIEWER BADGE */}
    <AuthorCard
      author={data.author}
      reviewedBy={data.reviewedBy}
      publishDate={data.publishDate}
      updatedDate={data.updatedDate}
      readingTime={data.readingTime}
    />

    {/* 3. KEY TAKEAWAYS */}
    <KeyTakeaways takeaways={data.keyTakeaways} />

    {/* 4. MAIN ARTICLE CONTENT BODY */}
    <article class="prose prose-slate max-w-none bg-canvas border border-hairline rounded-3xl p-6 sm:p-10 shadow-soft text-body space-y-6">
      <slot />
    </article>

    {/* 5. CALCULATOR CTA */}
    <GuideCTA
      title="Calculate Your Custom Numbers"
      description="Run your exact numbers using our institutional-grade financial decision engines."
      buttonText="Launch EMI Calculator"
      buttonUrl="/tools/loans/emi-calculator/"
    />

    {/* 6. FAQ ACCORDION */}
    {data.faqs && data.faqs.length > 0 && (
      <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-soft">
        <h3 class="text-xl font-bold font-heading text-ink">Frequently Asked Questions</h3>
        <FAQAccordion faqs={data.faqs} client:visible />
      </div>
    )}

    {/* 7. INTELLIGENT KNOWLEDGE GRAPH RECOMMENDATIONS */}
    <RelatedContentGrid content={relatedData} />

    {/* 8. EXPLORE MORE SILOS (ZERO DEAD ENDS) */}
    <ExploreMoreTools category={data.category} />
  </div>
</ToolLayout>
