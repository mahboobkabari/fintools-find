---
import FlagshipLayout from './FlagshipLayout.astro';
import PomisCalculatorWidget from '../calculators/PomisCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Select Account Ownership & Deposit Amount',
    description: 'Choose between Single Account (Max ₹9 Lakhs) or Joint Account (Max ₹15 Lakhs) and enter your proposed deposit.',
  },
  {
    stepNumber: '02',
    title: 'Review Government Notified Monthly Rate',
    description: 'Verify the 7.4% p.a. government-notified interest rate paid directly into your post office or bank savings account every month.',
  },
  {
    stepNumber: '03',
    title: 'Audit Monthly Cash Flow & Income Tax Slab',
    description: 'Calculate your exact guaranteed monthly payout, annual interest, 5-year total interest, and income tax slab estimate.',
  },
  {
    stepNumber: '04',
    title: 'Compare Yields against Bank FDs & SCSS',
    description: 'Inspect guaranteed POMIS monthly payouts against 5-year commercial bank fixed deposits and Senior Citizens Savings Scheme (SCSS).',
    colorClass: 'text-semantic-success',
  },
];

const targetPersonas = [
  {
    title: 'Retirees Seeking Guaranteed Passive Income',
    description: 'Senior citizens and retirees looking for reliable, 100% sovereign-guaranteed monthly interest income.',
    bgClass: 'bg-emerald-50',
    textClass: 'text-semantic-success',
  },
  {
    title: 'Couples & Family Joint Account Holders',
    description: 'Joint account holders maximizing the ₹15 Lakh statutory joint deposit limit for ₹9,250 guaranteed monthly cash flow.',
    bgClass: 'bg-purple-50',
    textClass: 'text-purple-600',
  },
  {
    title: 'Conservative Monthly Yield Investors',
    description: 'Risk-averse depositors allocating capital into Post Office Small Savings with zero market volatility.',
    bgClass: 'bg-blue-50',
    textClass: 'text-primary',
  },
  {
    title: 'Fixed Income & Budget Planners',
    description: 'Households funding monthly living expenses, utility bills, or EMI payments through fixed monthly interest payouts.',
    bgClass: 'bg-indigo-50',
    textClass: 'text-indigo-600',
  },
];

const formulaDetails = {
  title: 'Post Office Monthly Income Scheme (POMIS) Statutory Formulas',
  formula: '\\text{Monthly Interest} = \\frac{\\text{Deposit} \\times r}{12}, \\quad \\text{Total 5Y Interest} = \\text{Monthly Interest} \\times 60',
  parameters: [
    {
      symbol: '\\text{Deposit}',
      title: 'Principal Deposit',
      description: 'Lump sum deposit (Capped at ₹9L for Single Account, ₹15L for Joint Account).',
      colorClass: 'text-primary',
    },
    {
      symbol: 'r',
      title: 'Notified POMIS Rate (% p.a.)',
      description: '7.4% p.a. government-notified interest rate payable monthly.',
      colorClass: 'text-emerald-600',
    },
    {
      symbol: '\\text{Monthly Interest}',
      title: 'Monthly Cash Flow Payout',
      description: 'Fixed interest credited to your savings account on the same day of each month.',
      colorClass: 'text-indigo-600',
    },
    {
      symbol: '\\text{Premature Penalty}',
      title: 'Statutory Penalty',
      description: '2% principal penalty between 1–3 years; 1% principal penalty between 3–5 years.',
      colorClass: 'text-purple-600',
    },
  ],
};

const caseStudies = [
  {
    title: 'Benchmark Case Study: Max Single Account Deposit (₹9 Lakhs @ 7.4% p.a.)',
    tag: 'Max Single Account',
    subtitle: 'Optimal Individual Sovereign Monthly Cash Flow',
    metrics: [
      { label: 'Principal Deposit', value: '₹900,000', colorClass: 'text-primary font-bold' },
      { label: 'Guaranteed Monthly Income', value: '₹5,550/mo', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Annual Interest Income', value: '₹66,600/yr', colorClass: 'text-indigo-600 font-bold' },
      { label: 'Total 5-Year Interest Received', value: '₹333,000', colorClass: 'text-purple-600 font-bold' },
    ],
    takeaway: 'Depositing the statutory maximum ₹9 Lakhs in a single POMIS account generates ₹5,550 in guaranteed tax-assessed monthly cash flow, totaling ₹3,33,000 in interest over 5 years while preserving 100% of the ₹9 Lakh principal.',
  },
  {
    title: 'Benchmark Case Study: Max Joint Account Deposit (₹15 Lakhs @ 7.4% p.a.)',
    tag: 'Max Joint Account',
    subtitle: 'Joint Husband-Wife Statutory Limit Allocation',
    metrics: [
      { label: 'Joint Principal Deposit', value: '₹1,500,000', colorClass: 'text-primary font-bold' },
      { label: 'Guaranteed Monthly Income', value: '₹9,250/mo', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Annual Interest Income', value: '₹111,000/yr', colorClass: 'text-indigo-600 font-bold' },
      { label: 'Total 5-Year Interest Received', value: '₹555,000', colorClass: 'text-purple-600 font-bold' },
    ],
    takeaway: 'A joint POMIS account with a ₹15 Lakh deposit generates ₹9,250 per month (₹1,11,000 per year) with zero market risk, returning the full ₹15 Lakhs at 5-year maturity.',
  },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
>
  <PomisCalculatorWidget slot="calculator" client:visible />
</FlagshipLayout>
