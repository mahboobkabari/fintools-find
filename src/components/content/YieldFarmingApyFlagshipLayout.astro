---
import FlagshipLayout from './FlagshipLayout.astro';
import YieldFarmingApyCalculatorWidget from '../calculators/YieldFarmingApyCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Deposit Capital into Protocol Farm or Vault',
    description: 'Capital is committed to the decentralized smart contract, deducting any initial deposit fee from the working principal.',
  },
  {
    stepNumber: '02',
    title: 'Yield Accrual & Compounding Cycles',
    description: 'The farm generates returns via automated swap fees, protocol emissions, or auto-compounding interest across selected frequencies.',
  },
  {
    stepNumber: '03',
    title: 'Deduct Platform & Exit Fees',
    description: 'Performance fees on generated yield and protocol withdrawal fees are deducted from gross earnings upon harvesting.',
  },
  {
    stepNumber: '04',
    title: 'Net Realized Return & Token Price Adjustment',
    description: 'Reward tokens are valued at market spot prices, netting against fee drag and impermanent loss to determine actual financial alpha.',
    colorClass: 'text-semantic-success',
  },
];

const targetPersonas = [
  {
    title: 'DeFi Yield Farmers & Liquidity Miners',
    description: 'Evaluating net realized yields after performance fees, gas costs, and reward token emission dilution.',
    bgClass: 'bg-indigo-50',
    textClass: 'text-indigo-600',
  },
  {
    title: 'Auto-Compounding Vault Allocators',
    description: 'Quantifying the exponential alpha of daily automated reinvestment versus manual harvesting schedules.',
    bgClass: 'bg-blue-50',
    textClass: 'text-primary',
  },
  {
    title: 'Stablecoin Yield Seekers',
    description: 'Deploying capital to low-risk pegged asset pools (USDC/USDT) for steady, low-drag annualized returns.',
    bgClass: 'bg-emerald-50',
    textClass: 'text-semantic-success',
  },
  {
    title: 'Crypto Portfolio Managers',
    description: 'Benchmarking high-yield liquidity mining pools against simple passive staking and cold-storage holding.',
    bgClass: 'bg-amber-50',
    textClass: 'text-amber-600',
  },
];

const formulaDetails = {
  title: 'Yield Farming APY & Compounding Formulations',
  formula: '\\text{APY} = \\left(1 + \\frac{\\text{APR}}{m}\\right)^m - 1, \\quad \\text{Gross Yield} = V_{\\text{dep}} \\cdot \\left[\\left(1 + \\frac{\\text{APR}}{m}\\right)^{m \\cdot t} - 1\\right]',
  parameters: [
    {
      symbol: '\\text{APR}',
      title: 'Annual Percentage Rate',
      description: 'The annualized simple interest rate before factoring in the compounding of earned rewards.',
      colorClass: 'text-primary',
    },
    {
      symbol: '\\text{APY}',
      title: 'Annual Percentage Yield',
      description: 'The effective annual return reflecting the frequency of reward reinvestment and compounding: (1 + APR/m)^m - 1.',
      colorClass: 'text-emerald-600',
    },
    {
      symbol: 'm',
      title: 'Compounding Periods per Year',
      description: 'The number of times rewards are added to principal per year (e.g. 365 for daily, 12 for monthly, 0 for simple).',
      colorClass: 'text-amber-600',
    },
    {
      symbol: 'F_{\\text{total}}',
      title: 'Total Multi-Tier Fees',
      description: 'Sum of protocol deposit fees, platform performance fees on yield, and withdrawal exit fees.',
      colorClass: 'text-rose-600',
    },
  ],
};

const caseStudies = [
  {
    title: 'Case Study 1: Auto-Compounding Vault vs Simple Staking (20% APR)',
    tag: 'Yearn / Beefy Auto-Vault',
    subtitle: '$10,000 initial capital in a 20% APR pool over 365 days',
    metrics: [
      { label: 'Simple Interest Gross Yield (No Compounding)', value: '$2,000.00 USD (20.00% APY)' },
      { label: 'Daily Compounding Gross Yield', value: '$2,213.36 USD (22.13% APY)', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Platform Performance Fee (2% of Yield)', value: '-$44.27 USD' },
      { label: 'Net Annual Profit & Realized Return', value: '+$2,169.09 USD (+21.69% Net APY)', colorClass: 'text-semantic-success font-black' },
    ],
    takeaway: 'Daily automated reinvestment increases gross return by $213.36 (+10.7% compounding boost). Even after paying a 2% vault management fee ($44.27), the auto-compounding strategy delivers $169.09 more net profit than manual non-compounded staking.',
  },
  {
    title: 'Case Study 2: High Headline APR Eroded by -60% Reward Token Price Drop',
    tag: 'Volatile Liquidity Mining Farm',
    subtitle: '$10,000 capital in an 80% APR farm over 90 days with reward token dropping from $10 to $4',
    metrics: [
      { label: 'Nominal Reward Value at Entry Price ($10)', value: '$1,972.60 USD (197.26 Tokens)' },
      { label: 'Harvested Reward Value at Exit Price ($4)', value: '$789.04 USD (-60% Price Drag)', colorClass: 'text-rose-600 font-bold' },
      { label: 'Deposit & Performance Fees Paid', value: '-$150.00 USD' },
      { label: 'Net Realized 90-Day Profit', value: '+$639.04 USD (+6.39% Net ROI)', colorClass: 'text-amber-600 font-bold' },
    ],
    takeaway: 'While the 80% headline APR promised substantial nominal gains, aggressive reward token inflation reduced token value by 60%, pulling the annualized net realized return down to ~25.9%. Evaluating reward token price risk is essential for farming profitability.',
  },
];

const strategies = [
  {
    number: '01',
    title: 'Evaluate Net APY Rather than Advertised APR',
    description: 'Always subtract protocol deposit fees, performance cuts, and gas execution costs from headline yields. High gross yields quickly evaporate under aggressive fee structures.',
  },
  {
    number: '02',
    title: 'Assess Reward Token Emission Schedules',
    description: 'Yield paid in hyper-inflationary governance tokens tends to suffer severe price depreciation. Consider immediate auto-selling or farming stable pairs to preserve principal.',
  },
  {
    number: '03',
    title: 'Leverage Auto-Compounding for High-APR Farms',
    description: 'The mathematical divergence between APR and APY grows exponentially at higher rates. A 100% APR farm achieves 171.46% APY under daily compounding.',
  },
  {
    number: '04',
    title: 'Model Duration Against Break-Even Hurdle Rates',
    description: 'If a pool charges a 3% deposit fee, short-term farming (e.g. 7 days) requires an exorbitant APR just to break even. Match your planned duration with our break-even solver.',
  },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
  strategies={strategies}
>
  <div slot="calculator">
    <YieldFarmingApyCalculatorWidget client:visible />
  </div>
</FlagshipLayout>
