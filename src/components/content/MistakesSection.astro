---
export interface Props {
  mistakes: string[];
}

const { mistakes = [] } = Astro.props;
if (!mistakes || mistakes.length === 0) return null;
---

<div class="my-8 p-6 bg-canvas border border-hairline rounded-xl shadow-soft">
  <div class="flex items-center gap-2 mb-4 text-semantic-down">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <h3 class="text-lg font-semibold text-ink">Common Mistakes to Avoid</h3>
  </div>
  <ul class="space-y-3 text-sm text-body">
    {mistakes.map((item) => (
      <li class="flex items-start gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-semantic-down mt-2 shrink-0" />
        <span class="leading-relaxed">{item}</span>
      </li>
    ))}
  </ul>
</div>
