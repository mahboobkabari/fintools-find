---
import FlagshipLayout from './FlagshipLayout.astro';
import CreditCardPayoffCalculatorWidget from '../calculators/CreditCardPayoffCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'List Credit Cards & Interest Rates (APR)',
    description: 'Enter balance, APR %, and user minimum payment (or use illustrative defaults) for each card.',
  },
  {
    stepNumber: '02',
    title: 'Set Total Monthly Payoff Budget',
    description: 'Specify how much total money you can dedicate monthly across all credit cards.',
  },
  {
    stepNumber: '03',
    title: 'Compare Debt Avalanche vs Snowball',
    description: 'Evaluate interest savings under Debt Avalanche (highest APR first) vs Debt Snowball (lowest balance).',
  },
];

const benchmarkCaseStudies = [
  {
    persona: 'High-Interest Retail Store Cards',
    scenario: 'Debt = ₹2.25 Lakhs across 3 cards | APRs = 36%, 30%, 24% | Budget = ₹15,000/mo',
    recommendation: 'Debt Avalanche saves ₹42,000+ in interest vs minimum payments, reaching debt freedom in 18 months.',
  },
  {
    persona: 'Single Heavy Credit Balance',
    scenario: 'Balance = ₹2.00 Lakhs | APR = 28% | Target Payment = ₹10,000/mo',
    recommendation: 'Doubling payment from minimum ₹6,000 cuts payoff time from 54 months to 26 months.',
  },
  {
    persona: 'Balanced Household Credit Deck',
    scenario: 'Debt = ₹2.75 Lakhs | 3 cards | Budget = ₹18,000/mo',
    recommendation: 'Debt Avalanche clears high-APR 30% card first, saving ₹14,500 more interest than Debt Snowball.',
  },
];
---

<FlagshipLayout data={data} slug={slug}>
  <CreditCardPayoffCalculatorWidget client:load />

  {/* Educational Guidance Section */}
  <section class="mt-12 space-y-8 border-t border-hairline pt-8">
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
        How to Eliminate Credit Card Debt Using the Debt Avalanche Strategy
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        The Debt Avalanche strategy accelerates debt payoff by paying minimums on all cards while channeling every extra available rupee/dollar into the card with the highest Annual Percentage Rate (APR %).
      </p>
    </div>

    {/* 3-Step Process Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {timelineSteps.map((step) => (
        <div class="p-6 bg-canvas border border-hairline rounded-2xl space-y-3 shadow-soft">
          <span class="text-xs font-mono font-black px-2.5 py-1 bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 rounded-md inline-block">
            Step {step.stepNumber}
          </span>
          <h3 class="text-base font-bold text-ink">{step.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    {/* Benchmark Household Case Studies */}
    <div class="space-y-4 pt-6 border-t border-hairline">
      <h3 class="text-lg font-bold text-ink">
        Illustrative Credit Payoff Benchmark Scenarios
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benchmarkCaseStudies.map((cs) => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-2">
            <span class="text-xs font-bold text-rose-600 block">{cs.persona}</span>
            <p class="text-xs font-semibold text-ink">{cs.scenario}</p>
            <p class="text-xs text-muted leading-relaxed">{cs.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</FlagshipLayout>
