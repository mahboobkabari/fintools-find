---
import FlagshipLayout from './FlagshipLayout.astro';
import SipCalculatorWidget from '../calculators/SipCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  { stepNumber: '01', title: 'Monthly Contribution', description: 'Fixed amount auto-debited monthly on chosen date into diversified equity/debt funds.' },
  { stepNumber: '02', title: 'Rupee Cost Averaging', description: 'Buy more mutual fund units when markets dip and fewer units during market rallies.' },
  { stepNumber: '03', title: 'Power of Compounding', description: 'Returns earned in early years generate interest on interest across multi-decade horizons.' },
  { stepNumber: '04', title: 'Corpus Redemption', description: 'Harvest accumulated wealth at maturity with long-term capital gains (LTCG) tax benefits.' },
];

const targetPersonas = [
  { title: 'Salaried Professionals', description: 'Automate monthly savings from salary to build long-term wealth effortlessly without timing markets.', bgClass: 'bg-blue-50', textClass: 'text-primary' },
  { title: 'Retirement Planners', description: 'Build a multi-crore retirement nest egg over 20–30 years using disciplined index and flexi-cap SIPs.', bgClass: 'bg-emerald-50', textClass: 'text-semantic-success' },
  { title: 'Parents & Education Planning', description: 'Create dedicated target funds for child higher education, overseas college fees, and marriage goals.', bgClass: 'bg-sky-50', textClass: 'text-accent-sky' },
  { title: 'First-Time Investors', description: 'Start wealth creation journeys with accessible monthly amounts as low as ₹500/month.', bgClass: 'bg-amber-50', textClass: 'text-semantic-warning' },
];

const formulaDetails = {
  title: 'The Compound Growth SIP Formula',
  formula: 'M = P \\times \\left[ \\frac{(1 + i)^n - 1}{i} \\right] \\times (1 + i)',
  parameters: [
    { symbol: 'M', title: 'Maturity Corpus Value', description: 'Expected final accumulated wealth corpus at tenure end.', colorClass: 'text-primary' },
    { symbol: 'P', title: 'Monthly SIP Amount', description: 'Fixed regular monthly installment contribution.', colorClass: 'text-semantic-success' },
    { symbol: 'i', title: 'Monthly Interest Rate', description: 'Expected annual return rate divided by 12 months (Annual Rate / 12 / 100).', colorClass: 'text-accent-amber' },
    { symbol: 'n', title: 'Tenure in Months', description: 'Total investment duration in months (Years × 12).', colorClass: 'text-accent-sky' },
  ],
};

const caseStudies = [
  {
    title: '₹10,000 / Month for 15 Years @ 12% p.a.',
    tag: '180 Months',
    subtitle: 'Wealth Builder',
    metrics: [
      { label: 'Total Capital Invested', value: '₹18,00,000' },
      { label: 'Estimated Returns Earned', value: '₹32,45,760', colorClass: 'text-semantic-success font-bold' },
      { label: 'Total Maturity Corpus Value', value: '₹50,45,760', colorClass: 'text-primary font-bold' },
    ],
    takeaway: 'Over 15 years, estimated compounding returns (₹32.45L) exceed total out-of-pocket investment (₹18L) by 1.8x.',
  },
  {
    title: '₹5,000 / Month for 25 Years @ 12% p.a.',
    tag: '300 Months',
    subtitle: 'Long-term Power',
    metrics: [
      { label: 'Total Capital Invested', value: '₹15,00,000' },
      { label: 'Estimated Returns Earned', value: '₹79,88,175', colorClass: 'text-semantic-success font-bold' },
      { label: 'Total Maturity Corpus Value', value: '₹94,88,175', colorClass: 'text-primary font-bold' },
    ],
    takeaway: 'Extending tenure to 25 years generates ₹79.88 Lakhs in returns on just ₹15 Lakhs invested—showing compounding acceleration.',
  },
];

const comparisonData = {
  title: 'Systematic Investment Plan (SIP) vs. Lump Sum Investment',
  subtitle: 'Comparing disciplined monthly investing against one-time upfront investment',
  optionA: {
    badge: 'RECOMMENDED FOR SALARIED',
    title: 'Systematic Investment Plan (SIP)',
    items: [
      { isPositive: true, text: 'Market Volatility Shield: Rupee cost averaging eliminates risk of bad market entry timing.' },
      { isPositive: true, text: 'Financial Discipline: Automates monthly savings directly from salary into equity assets.' },
      { isPositive: true, text: 'Accessibility: Start wealth creation with flexible amounts as low as ₹500/month.' },
    ],
  },
  optionB: {
    badge: 'HIGH WINDFALL CAPITAL',
    title: 'Lump Sum Investment',
    items: [
      { isPositive: false, text: 'Timing Dependence: High short-term risk if full lump sum is invested at market peak.' },
      { isPositive: false, text: 'Capital Requirement: Requires large upfront liquidity (e.g., bonus, property sale, inheritance).' },
      { isPositive: false, text: 'Compounding Base: Full capital earns returns from Day 1 if market continues rising.' },
    ],
  },
};

const strategies = [
  { number: '01', title: 'Start Early for Multi-Decade Compounding', description: 'Starting a SIP at age 25 instead of age 35 yields more than double the final wealth with identical monthly contributions.' },
  { number: '02', title: 'Step-Up SIP Annually by 10%', description: 'Increasing monthly SIP by 10% each year alongside salary increments can double your final maturity corpus.' },
  { number: '03', title: 'Stay Invested During Market Corrections', description: 'Market downturns allow your SIP to purchase more mutual fund units at discounted NAVs, boosting long-term returns.' },
  { number: '04', title: 'Align SIPs with Concrete Financial Goals', description: 'Assign specific goals (e.g. retirement, house deposit, education) to separate SIP folios for disciplined focus.' },
  { number: '05', title: 'Rebalance Portfolio Annually', description: 'Periodically review equity vs debt allocation to lock in gains and align with changing risk tolerance.' },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
  comparisonData={comparisonData}
  strategies={strategies}
>
  <SipCalculatorWidget slot="calculator" client:visible />
</FlagshipLayout>
