---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import EmiCalculatorWidget from '../calculators/EmiCalculatorWidget';
import FaqAccordion from '../calculators/primitives/FaqAccordion.jsx';
import RelatedTools from '../RelatedTools.astro';
import AdSlot from '../AdSlot.astro';
import { generateCombinedSchemas } from '@utils/schema.js';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const currentCanonical = Astro.url.href;
const reviewerName = data.eeat?.reviewedBy || 'FinTool Engineering & Quant Team';
const formattedDate = data.updatedDate
  ? new Date(data.updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'August 2026';

const breadcrumbItems = [
  { name: 'Home', url: 'https://fintool.org/' },
  { name: data.categoryName, url: `https://fintool.org/tools/${data.category}/` },
  { name: data.title, url: currentCanonical },
];

const combinedSchemas = generateCombinedSchemas({
  title: data.title,
  description: data.metaDescription,
  url: currentCanonical,
  categoryName: data.categoryName,
  breadcrumbs: breadcrumbItems,
  faqs: data.faqs || [],
});

const faqsList = data.faqs || [];
---

<BaseLayout title={data.title} description={data.metaDescription} schema={combinedSchemas}>
  {/* Flagship Hero & Workspace Background Container */}
  <div class="bg-background min-h-screen pb-20">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8 py-8">
      {/* Breadcrumb Navigation */}
      <Breadcrumbs categorySlug={data.category} categoryName={data.categoryName} toolTitle={data.title} />

      {/* Hero Header Section */}
      <header class="my-8 text-center max-w-4xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 bg-primary/10 border border-primary/20 text-primary px-4 py-1.5 rounded-pill text-xs font-mono font-bold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span>FLAGSHIP CALCULATOR · 100% CLIENT-SIDE PRIVATE</span>
        </div>

        <h1 class="font-heading font-extrabold text-3xl sm:text-4xl md:text-5xl text-ink tracking-tight leading-tight">
          EMI Calculator: Instant Loan Repayment & Amortization Schedule
        </h1>

        <p class="text-body text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          {data.metaDescription}
        </p>

        {/* EEAT & Trust Signals Pills Bar */}
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs font-mono text-muted">
          <span class="inline-flex items-center gap-1.5 bg-canvas px-3.5 py-1.5 rounded-pill border border-hairline shadow-soft font-semibold text-ink">
            <svg class="w-4 h-4 text-semantic-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Reviewed by {reviewerName}
          </span>

          <span class="inline-flex items-center gap-1.5 bg-canvas px-3.5 py-1.5 rounded-pill border border-hairline shadow-soft">
            <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Updated {formattedDate}
          </span>

          <span class="inline-flex items-center gap-1.5 bg-canvas px-3.5 py-1.5 rounded-pill border border-hairline shadow-soft">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Zero Server Data Storage
          </span>
        </div>
      </header>

      {/* Calculator Workspace Above The Fold */}
      <section class="mb-16">
        <EmiCalculatorWidget client:visible />
      </section>

      <AdSlot slotId="emi-below-widget" />

      {/* Main SaaS Feature Sections */}
      <div class="space-y-16 mt-16">
        
        {/* SECTION 1: How EMI Works (4-Step Icon Timeline) */}
        <section class="bg-canvas border border-hairline rounded-3xl p-8 md:p-10 shadow-soft space-y-8">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Process Architecture</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">How Loan EMI Repayment Works</h2>
            <p class="text-body text-sm">Understanding the 4-phase lifecycle of an Equated Monthly Installment</p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
            {/* Step 1 */}
            <div class="p-6 bg-background border border-hairline rounded-2xl relative space-y-3 group hover:border-primary transition-all">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary font-mono font-bold flex items-center justify-center text-lg">01</div>
              <h3 class="font-heading font-bold text-ink text-base">Principal Disbursal</h3>
              <p class="text-xs text-body leading-relaxed">
                The lender approves and disburses the upfront loan principal (<span class="font-mono text-ink">$P$</span>) directly to your account or seller.
              </p>
            </div>

            {/* Step 2 */}
            <div class="p-6 bg-background border border-hairline rounded-2xl relative space-y-3 group hover:border-primary transition-all">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary font-mono font-bold flex items-center justify-center text-lg">02</div>
              <h3 class="font-heading font-bold text-ink text-base">Monthly Installment</h3>
              <p class="text-xs text-body leading-relaxed">
                You pay a fixed monthly amount (EMI) on a specified date each calendar month throughout tenure (<span class="font-mono text-ink">$n$</span>).
              </p>
            </div>

            {/* Step 3 */}
            <div class="p-6 bg-background border border-hairline rounded-2xl relative space-y-3 group hover:border-primary transition-all">
              <div class="w-10 h-10 rounded-xl bg-accent-amber/10 text-semantic-warning font-mono font-bold flex items-center justify-center text-lg">03</div>
              <h3 class="font-heading font-bold text-ink text-base">Interest & Principal Split</h3>
              <p class="text-xs text-body leading-relaxed">
                Early EMIs cover accrued interest; principal repayment increases progressively toward the end of tenure.
              </p>
            </div>

            {/* Step 4 */}
            <div class="p-6 bg-background border border-hairline rounded-2xl relative space-y-3 group hover:border-semantic-success transition-all">
              <div class="w-10 h-10 rounded-xl bg-semantic-success/10 text-semantic-success font-mono font-bold flex items-center justify-center text-lg">04</div>
              <h3 class="font-heading font-bold text-ink text-base">Zero Loan Closure</h3>
              <p class="text-xs text-body leading-relaxed">
                Upon final installment completion, outstanding principal reaches zero and the loan is fully extinguished.
              </p>
            </div>
          </div>
        </section>

        {/* SECTION 2: Who Should Use This Calculator (Use Case Personas) */}
        <section class="space-y-6">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Target Borrowers</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">Who Should Use an EMI Calculator?</h2>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 text-primary flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              </div>
              <h3 class="font-heading font-bold text-ink text-base">Home Buyers</h3>
              <p class="text-xs text-body leading-relaxed">
                Estimate 15–30 year mortgage EMIs, tax deductions under Section 80C/24(b), and long-term interest burden.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <div class="w-12 h-12 rounded-2xl bg-sky-50 text-accent-sky flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                </svg>
              </div>
              <h3 class="font-heading font-bold text-ink text-base">Car & Vehicle Buyers</h3>
              <p class="text-xs text-body leading-relaxed">
                Calculate 3–7 year auto loan monthly payments and compare dealer interest rate quotes.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-semantic-success flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <h3 class="font-heading font-bold text-ink text-base">Personal Loan Borrowers</h3>
              <p class="text-xs text-body leading-relaxed">
                Analyze unsecured debt repayments and verify whether monthly installments fit under 40% of income.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <div class="w-12 h-12 rounded-2xl bg-amber-50 text-semantic-warning flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
              </div>
              <h3 class="font-heading font-bold text-ink text-base">Education Loan Students</h3>
              <p class="text-xs text-body leading-relaxed">
                Plan post-degree moratorium periods and evaluate repayment schedules before signing loan offers.
              </p>
            </div>
          </div>
        </section>

        {/* SECTION 3: Key Benefits & Features Grid */}
        <div class="grid md:grid-cols-2 gap-8">
          {/* Benefits Card */}
          <div class="bg-canvas border border-hairline rounded-3xl p-8 shadow-soft space-y-6">
            <h3 class="font-heading font-bold text-xl text-ink flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-semantic-success"></span>
              Key Benefits of Using FinTool EMI Engine
            </h3>
            <ul class="space-y-4 text-sm text-body">
              {data.benefits && data.benefits.map((benefit: string) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-semantic-success flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="leading-relaxed">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Features Card */}
          <div class="bg-canvas border border-hairline rounded-3xl p-8 shadow-soft space-y-6">
            <h3 class="font-heading font-bold text-xl text-ink flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-primary"></span>
              Platform Features & Functionality
            </h3>
            <ul class="space-y-4 text-sm text-body">
              {data.features && data.features.map((feature: string) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {/* SECTION 4: Premium Math Formula Component */}
        <section class="bg-canvas border border-hairline rounded-3xl p-8 md:p-10 shadow-soft space-y-6">
          <div class="border-b border-hairline pb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Mathematical Engine</span>
              <h2 class="font-heading font-bold text-2xl text-ink">The Reducing Balance EMI Formula</h2>
            </div>
            <span class="text-xs font-mono bg-surface-strong px-3 py-1 rounded-pill text-muted font-semibold">Standard TVM Annuity</span>
          </div>

          {/* LaTeX Formula Visual Card */}
          <div class="p-8 bg-gradient-to-r from-slate-900 to-slate-800 text-white rounded-2xl text-center space-y-4 shadow-glass">
            <span class="text-xs font-mono text-blue-400 font-semibold uppercase tracking-widest block">Annuity Repayment Formula</span>
            <div class="font-mono text-2xl sm:text-3xl md:text-4xl text-white font-bold tracking-wider overflow-x-auto py-2">
              EMI = P × r × [ (1 + r)ⁿ / ((1 + r)ⁿ - 1) ]
            </div>
          </div>

          {/* Parameter Definition Cards */}
          <div class="grid sm:grid-cols-3 gap-4 text-sm">
            <div class="p-5 bg-background border border-hairline rounded-xl space-y-1">
              <span class="font-mono font-bold text-primary text-base block">P — Principal Amount</span>
              <p class="text-xs text-body leading-relaxed">The total original lump-sum capital borrowed from the bank.</p>
            </div>

            <div class="p-5 bg-background border border-hairline rounded-xl space-y-1">
              <span class="font-mono font-bold text-accent-amber text-base block">r — Monthly Rate</span>
              <p class="text-xs text-body leading-relaxed">Annual interest rate divided by 12 months (expressed as a decimal: Annual Rate / 12 / 100).</p>
            </div>

            <div class="p-5 bg-background border border-hairline rounded-xl space-y-1">
              <span class="font-mono font-bold text-semantic-success text-base block">n — Tenure in Months</span>
              <p class="text-xs text-body leading-relaxed">Total loan repayment duration in months (Years × 12).</p>
            </div>
          </div>
        </section>

        {/* SECTION 5: Practical Worked Example Cards */}
        <section class="space-y-6">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Case Studies</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">Practical Worked Calculation Examples</h2>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            {/* Example 1 Card */}
            <div class="bg-canvas border border-hairline rounded-3xl p-8 shadow-soft space-y-6 hover:border-primary transition-all">
              <div class="flex items-center justify-between border-b border-hairline pb-4">
                <div>
                  <span class="text-xs font-mono font-bold text-primary block">Example 1</span>
                  <h3 class="font-heading font-bold text-lg text-ink">Home Loan (₹10 Lakhs @ 8.5% for 20 Yrs)</h3>
                </div>
                <span class="text-xs font-mono bg-blue-50 text-primary font-bold px-3 py-1 rounded-pill">240 Months</span>
              </div>

              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Monthly Interest Rate (<span class="font-mono">$r$</span>)</span>
                  <span class="font-mono font-semibold text-ink">0.007083</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Monthly EMI Payment</span>
                  <span class="font-mono font-bold text-primary text-base">₹8,678 / mo</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Total Repayment Amount</span>
                  <span class="font-mono font-semibold text-ink">₹20,82,720</span>
                </div>
                <div class="flex justify-between items-center py-1">
                  <span class="text-body">Total Cumulative Interest</span>
                  <span class="font-mono font-bold text-semantic-warning text-base">₹10,82,720</span>
                </div>
              </div>

              <div class="p-4 bg-amber-50 border border-amber-200/60 rounded-2xl text-xs text-amber-900 leading-relaxed font-medium">
                <strong>Key Takeaway:</strong> Over a 20-year term, cumulative interest (₹10.82 Lakhs) exceeds the original borrowed principal (₹10 Lakhs).
              </div>
            </div>

            {/* Example 2 Card */}
            <div class="bg-canvas border border-hairline rounded-3xl p-8 shadow-soft space-y-6 hover:border-primary transition-all">
              <div class="flex items-center justify-between border-b border-hairline pb-4">
                <div>
                  <span class="text-xs font-mono font-bold text-accent-sky block">Example 2</span>
                  <h3 class="font-heading font-bold text-lg text-ink">Personal Loan (₹5 Lakhs @ 11.5% for 3 Yrs)</h3>
                </div>
                <span class="text-xs font-mono bg-sky-50 text-accent-sky font-bold px-3 py-1 rounded-pill">36 Months</span>
              </div>

              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Monthly Interest Rate (<span class="font-mono">$r$</span>)</span>
                  <span class="font-mono font-semibold text-ink">0.009583</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Monthly EMI Payment</span>
                  <span class="font-mono font-bold text-accent-sky text-base">₹16,493 / mo</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-hairline-soft">
                  <span class="text-body">Total Repayment Amount</span>
                  <span class="font-mono font-semibold text-ink">₹5,93,755</span>
                </div>
                <div class="flex justify-between items-center py-1">
                  <span class="text-body">Total Cumulative Interest</span>
                  <span class="font-mono font-bold text-semantic-warning text-base">₹93,755</span>
                </div>
              </div>

              <div class="p-4 bg-blue-50 border border-blue-200/60 rounded-2xl text-xs text-blue-900 leading-relaxed font-medium">
                <strong>Key Takeaway:</strong> On a short 3-year term, interest represents only 15.8% of total outflow compared to 52% in a 20-year mortgage.
              </div>
            </div>
          </div>
        </section>

        {/* SECTION 6: Reducing Balance vs Flat Rate Comparison Cards */}
        <section class="bg-canvas border border-hairline rounded-3xl p-8 md:p-10 shadow-soft space-y-8">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Interest Rate Mechanics</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">Reducing Balance vs. Flat Rate Comparison</h2>
            <p class="text-body text-sm">Understanding how banks calculate interest on your outstanding loan principal</p>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            {/* Reducing Balance Card */}
            <div class="p-8 bg-background border-2 border-semantic-success/30 rounded-2xl space-y-4 relative">
              <span class="inline-block bg-semantic-success text-white font-mono text-xs font-bold px-3 py-1 rounded-pill">
                RECOMMENDED (BANK STANDARD)
              </span>
              <h3 class="font-heading font-bold text-xl text-ink">Reducing Balance Interest Rate</h3>
              
              <ul class="space-y-3 text-xs text-body">
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-success font-bold">✓</span>
                  <span><strong>Calculation Method:</strong> Interest calculated only on the remaining unpaid principal balance each month.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-success font-bold">✓</span>
                  <span><strong>Effective Interest:</strong> Lower total cumulative interest paid over the loan term.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-success font-bold">✓</span>
                  <span><strong>Industry Standard:</strong> Standard rule used for [Home Loans](/tools/loans/home-loan-calculator/) and [Car Loans](/tools/loans/car-loan-calculator/).</span>
                </li>
              </ul>
            </div>

            {/* Flat Rate Card */}
            <div class="p-8 bg-background border-2 border-semantic-warning/30 rounded-2xl space-y-4 relative">
              <span class="inline-block bg-semantic-warning text-white font-mono text-xs font-bold px-3 py-1 rounded-pill">
                EXPENSIVE (CONSUMER LOANS)
              </span>
              <h3 class="font-heading font-bold text-xl text-ink">Flat Interest Rate</h3>
              
              <ul class="space-y-3 text-xs text-body">
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-warning font-bold">⚠️</span>
                  <span><strong>Calculation Method:</strong> Interest charged on original full principal throughout complete loan duration.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-warning font-bold">⚠️</span>
                  <span><strong>Effective Interest:</strong> Effective interest burden is almost double the advertised flat rate.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-semantic-warning font-bold">⚠️</span>
                  <span><strong>Industry Use:</strong> Common in offline consumer durable schemes and short-term NBFC offers.</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        {/* SECTION 7: Tax Deductions Callout Cards */}
        <section class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white rounded-3xl p-8 md:p-10 shadow-glass space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-300">Statutory Tax Relief</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-white">Tax Deductions Available on Home Loan EMIs</h2>
            <p class="text-blue-100 text-sm max-w-2xl">Income Tax Act provisions in India offering tax relief on home loan repayments</p>
          </div>

          <div class="grid sm:grid-cols-2 gap-6">
            <div class="p-6 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 space-y-2">
              <span class="text-xs font-mono text-emerald-300 font-bold uppercase tracking-wider block">Section 80C</span>
              <h3 class="font-heading font-bold text-lg text-white">Principal Repayment Deduction</h3>
              <p class="text-xs text-blue-100 leading-relaxed">
                Claim up to <strong class="text-white font-mono text-sm font-bold">₹1,50,000</strong> per financial year on principal loan repayments under Section 80C.
              </p>
            </div>

            <div class="p-6 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 space-y-2">
              <span class="text-xs font-mono text-amber-300 font-bold uppercase tracking-wider block">Section 24(b)</span>
              <h3 class="font-heading font-bold text-lg text-white">Interest Repayment Deduction</h3>
              <p class="text-xs text-blue-100 leading-relaxed">
                Claim tax deductions up to <strong class="text-white font-mono text-sm font-bold">₹2,00,000</strong> per financial year on cumulative interest paid for self-occupied properties.
              </p>
            </div>
          </div>
        </section>

        {/* SECTION 8: 5 Practical Ways to Reduce EMI */}
        <section class="space-y-6">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Optimization Strategies</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">5 Practical Ways to Reduce Monthly Loan EMI</h2>
            <p class="text-body text-sm">Actionable steps to lower your monthly outflow and save cumulative interest</p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-md inline-block">Strategy 01</span>
              <h3 class="font-heading font-bold text-ink text-base">Increase Down Payment</h3>
              <p class="text-xs text-body leading-relaxed">
                Making a higher initial down payment directly reduces principal amount (<span class="font-mono">$P$</span>), lowering monthly EMI. Calculate limits with our <a href="/tools/loans/loan-eligibility-calculator/" class="text-primary hover:underline font-semibold">Loan Eligibility Calculator</a>.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-md inline-block">Strategy 02</span>
              <h3 class="font-heading font-bold text-ink text-base">Extend Loan Tenure</h3>
              <p class="text-xs text-body leading-relaxed">
                Spreading principal payments over more months lowers monthly EMI, though it increases total cumulative interest charges over time.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-md inline-block">Strategy 03</span>
              <h3 class="font-heading font-bold text-ink text-base">Negotiate Interest Rate</h3>
              <p class="text-xs text-body leading-relaxed">
                A strong CIBIL credit score (750+) qualifies you for concessionary interest rates from prime bank lenders.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all">
              <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-md inline-block">Strategy 04</span>
              <h3 class="font-heading font-bold text-ink text-base">Make Partial Prepayments</h3>
              <p class="text-xs text-body leading-relaxed">
                Applying annual bonuses toward principal prepayments slashes interest burden. Measure savings with our <a href="/tools/loans/loan-prepayment-calculator/" class="text-primary hover:underline font-semibold">Loan Prepayment Calculator</a>.
              </p>
            </div>

            <div class="p-6 bg-canvas border border-hairline rounded-2xl shadow-soft space-y-3 hover:border-primary transition-all sm:col-span-2 lg:col-span-1">
              <span class="text-xs font-mono font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-md inline-block">Strategy 05</span>
              <h3 class="font-heading font-bold text-ink text-base">Optimize Debt Repayment</h3>
              <p class="text-xs text-body leading-relaxed">
                Compare prepayment vs tenure adjustment savings using our <a href="/tools/loans/loan-prepayment-calculator/" class="text-primary hover:underline font-semibold">Prepayment Tool</a> and <a href="/tools/loans/loan-eligibility-calculator/" class="text-primary hover:underline font-semibold">Eligibility Tool</a>.
              </p>
            </div>
          </div>
        </section>

        {/* SECTION 9: Common Mistakes Warning Cards */}
        {data.advancedContent?.commonMistakes && (
          <section class="bg-amber-500/5 border border-amber-500/20 rounded-3xl p-8 shadow-soft space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-semantic-warning/20 text-semantic-warning flex items-center justify-center font-bold text-lg">
                ⚠️
              </div>
              <div>
                <h3 class="font-heading font-bold text-xl text-ink">Common EMI Mistakes to Avoid</h3>
                <p class="text-xs text-muted">Critical borrowing oversights that cost borrowers thousands</p>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              {data.advancedContent.commonMistakes.map((mistake: string) => (
                <div class="p-5 bg-canvas border border-amber-200/80 rounded-2xl flex items-start gap-3 shadow-soft">
                  <span class="text-semantic-warning font-bold text-base mt-0.5">✕</span>
                  <p class="text-xs text-body leading-relaxed">{mistake}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* SECTION 10: Visually Rich Interactive FAQ Accordion */}
        <section class="bg-canvas border border-hairline rounded-3xl p-8 md:p-10 shadow-soft space-y-8">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Frequently Asked Questions</span>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-ink">Loan EMI Calculation FAQs</h2>
            <p class="text-body text-sm">Answers to common borrower questions about EMI calculations and loan math</p>
          </div>

          <FaqAccordion faqs={faqsList} client:visible />
        </section>

        {/* SECTION 11: Related Calculator Cards */}
        <section class="space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary">Tool Hub</span>
              <h2 class="font-heading font-bold text-2xl text-ink">Related Loan Calculators</h2>
            </div>
            <a href="/tools/loans/" class="text-xs font-semibold text-primary hover:underline">
              View All Loan Tools &rarr;
            </a>
          </div>

          <RelatedTools currentCategory={data.category} currentSlug={slug} manualRelatedTools={data.relatedTools || []} />
        </section>

      </div>
    </div>
  </div>
</BaseLayout>
