---
import FlagshipLayout from './FlagshipLayout.astro';
import EmiCalculatorWidget from '../calculators/EmiCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  { stepNumber: '01', title: 'Principal Disbursal', description: 'The lender approves and disburses the upfront loan principal ($P$) directly to your account or seller.' },
  { stepNumber: '02', title: 'Monthly Installment', description: 'You pay a fixed monthly amount (EMI) on a specified date each calendar month throughout tenure ($n$).' },
  { stepNumber: '03', title: 'Interest & Principal Split', description: 'Early EMIs cover accrued interest; principal repayment increases progressively toward the end of tenure.', colorClass: 'text-semantic-warning' },
  { stepNumber: '04', title: 'Zero Loan Closure', description: 'Upon final installment completion, outstanding principal reaches zero and the loan is fully extinguished.', colorClass: 'text-semantic-success' },
];

const targetPersonas = [
  { title: 'Home Buyers', description: 'Estimate 15–30 year mortgage EMIs, tax deductions under Section 80C/24(b), and long-term interest burden.', bgClass: 'bg-blue-50', textClass: 'text-primary' },
  { title: 'Car & Vehicle Buyers', description: 'Calculate 3–7 year auto loan monthly payments and compare dealer interest rate quotes.', bgClass: 'bg-sky-50', textClass: 'text-accent-sky' },
  { title: 'Personal Loan Borrowers', description: 'Analyze unsecured debt repayments and verify whether monthly installments fit under 40% of income.', bgClass: 'bg-emerald-50', textClass: 'text-semantic-success' },
  { title: 'Education Loan Students', description: 'Plan post-degree moratorium periods and evaluate repayment schedules before signing loan offers.', bgClass: 'bg-amber-50', textClass: 'text-semantic-warning' },
];

const formulaDetails = {
  title: 'The Reducing Balance EMI Formula',
  formula: 'EMI = P \\times r \\times \\left[ \\frac{(1 + r)^n}{(1 + r)^n - 1} \\right]',
  parameters: [
    { symbol: 'P', title: 'Principal Amount', description: 'The total original lump-sum capital borrowed from the bank.', colorClass: 'text-primary' },
    { symbol: 'r', title: 'Monthly Rate', description: 'Annual interest rate divided by 12 months (Annual Rate / 12 / 100).', colorClass: 'text-accent-amber' },
    { symbol: 'n', title: 'Tenure in Months', description: 'Total loan repayment duration in months (Years × 12).', colorClass: 'text-semantic-success' },
  ],
};

const taxProvisions = [
  { section: 'Section 80C', title: 'Principal Repayment Deduction', description: 'Claim tax deductions on principal loan repayments under Section 80C.', limitText: '₹1,50,000 / year', colorClass: 'text-emerald-300' },
  { section: 'Section 24(b)', title: 'Interest Repayment Deduction', description: 'Claim tax deductions on cumulative interest paid for self-occupied properties.', limitText: '₹2,00,000 / year', colorClass: 'text-amber-300' },
];

const caseStudies = [
  {
    title: 'Home Loan (₹10 Lakhs @ 8.5% for 20 Yrs)',
    tag: '240 Months',
    subtitle: 'Mortgage Amortization',
    metrics: [
      { label: 'Monthly Interest Rate (r)', value: '0.007083' },
      { label: 'Monthly EMI Payment', value: '₹8,678 / mo', colorClass: 'text-primary font-bold' },
      { label: 'Total Repayment Amount', value: '₹20,82,720' },
      { label: 'Total Cumulative Interest', value: '₹10,82,720', colorClass: 'text-semantic-warning font-bold' },
    ],
    takeaway: 'Over a 20-year term, cumulative interest (₹10.82 Lakhs) exceeds the original borrowed principal (₹10 Lakhs).',
  },
  {
    title: 'Personal Loan (₹5 Lakhs @ 11.5% for 3 Yrs)',
    tag: '36 Months',
    subtitle: 'Short-term Debt',
    metrics: [
      { label: 'Monthly Interest Rate (r)', value: '0.009583' },
      { label: 'Monthly EMI Payment', value: '₹16,493 / mo', colorClass: 'text-accent-sky font-bold' },
      { label: 'Total Repayment Amount', value: '₹5,93,755' },
      { label: 'Total Cumulative Interest', value: '₹93,755', colorClass: 'text-semantic-warning font-bold' },
    ],
    takeaway: 'On a short 3-year term, interest represents only 15.8% of total outflow compared to 52% in a 20-year mortgage.',
  },
];

const comparisonData = {
  title: 'Reducing Balance vs. Flat Rate Comparison',
  subtitle: 'Understanding how banks calculate interest on your outstanding loan principal',
  optionA: {
    badge: 'RECOMMENDED (BANK STANDARD)',
    title: 'Reducing Balance Interest Rate',
    items: [
      { isPositive: true, text: 'Calculation Method: Interest calculated only on the remaining unpaid principal balance each month.' },
      { isPositive: true, text: 'Effective Interest: Lower total cumulative interest paid over the loan term.' },
      { isPositive: true, text: 'Industry Standard: Standard rule used for Home Loans and Car Loans.' },
    ],
  },
  optionB: {
    badge: 'EXPENSIVE (CONSUMER LOANS)',
    title: 'Flat Interest Rate',
    items: [
      { isPositive: false, text: 'Calculation Method: Interest charged on original full principal throughout complete loan duration.' },
      { isPositive: false, text: 'Effective Interest: Effective interest burden is almost double the advertised flat rate.' },
      { isPositive: false, text: 'Industry Use: Common in offline consumer durable schemes and short-term NBFC offers.' },
    ],
  },
};

const strategies = [
  { number: '01', title: 'Increase Down Payment', description: 'Making a higher initial down payment directly reduces principal amount (P), lowering monthly EMI.' },
  { number: '02', title: 'Extend Loan Tenure', description: 'Spreading principal payments over more months lowers monthly EMI, though it increases total interest.' },
  { number: '03', title: 'Negotiate Interest Rate', description: 'A strong CIBIL credit score (750+) qualifies you for concessionary interest rates from prime bank lenders.' },
  { number: '04', title: 'Make Partial Prepayments', description: 'Applying annual bonuses toward principal prepayments slashes interest burden.' },
  { number: '05', title: 'Optimize Debt Repayment', description: 'Compare prepayment vs tenure adjustment savings using our financial planning tools.' },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  taxProvisions={taxProvisions}
  caseStudies={caseStudies}
  comparisonData={comparisonData}
  strategies={strategies}
>
  <EmiCalculatorWidget slot="calculator" client:visible />
</FlagshipLayout>
