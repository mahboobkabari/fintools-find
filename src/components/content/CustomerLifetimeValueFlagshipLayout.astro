---
import FlagshipLayout from './FlagshipLayout.astro';
import CustomerLifetimeValueCalculatorWidget from '../calculators/CustomerLifetimeValueCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Select Business Revenue Model',
    description: 'Choose between Subscription/SaaS (monthly recurring ARPU + churn) or Transactional/E-Commerce (average order value + purchase frequency).',
  },
  {
    stepNumber: '02',
    title: 'Input Margin & Blended Acquisition Cost (CAC)',
    description: 'Provide your gross margin percentage (deducting COGS, hosting, gateway fees) and blended customer acquisition cost across paid marketing and sales.',
  },
  {
    stepNumber: '03',
    title: 'Calculate Gross, Net & Discounted DCF LTV',
    description: 'Determine the total gross cash inflows and margin-adjusted lifetime profits generated by each customer over their active lifespan.',
  },
  {
    stepNumber: '04',
    title: 'Evaluate LTV:CAC Ratio & CAC Payback Horizon',
    description: 'Benchmark your unit economics against venture standards (3.0x - 5.0x ratio, <12 month payback) to optimize marketing spend allocation.',
    colorClass: 'text-semantic-success',
  },
];

const targetPersonas = [
  {
    title: 'B2B SaaS & Subscription Founders',
    description: 'Software leaders tracking churn decay curves, gross margin expansion, net retention rates, and enterprise tier pricing power.',
    bgClass: 'bg-indigo-50',
    textClass: 'text-indigo-600',
  },
  {
    title: 'D2C E-Commerce & Retail Marketers',
    description: 'Growth marketers balancing Google/Meta ad spend against customer repeat purchase frequency and basket size.',
    bgClass: 'bg-blue-50',
    textClass: 'text-primary',
  },
  {
    title: 'Venture Capital & Private Equity Investors',
    description: 'Investment associates evaluating unit economics health, cohort retention decay, and capital efficiency of target portfolio companies.',
    bgClass: 'bg-emerald-50',
    textClass: 'text-semantic-success',
  },
  {
    title: 'Digital Agencies & Service Consultancies',
    description: 'Professional service firms optimizing client retainer sizes, average relationship tenure, and business development acquisition costs.',
    bgClass: 'bg-amber-50',
    textClass: 'text-amber-600',
  },
];

const formulaDetails = {
  title: 'Customer Lifetime Value (CLV), LTV:CAC & Payback Mathematical Formulas',
  formula: '\\text{SaaS LTV} = \\frac{\\text{ARPU} \\times \\text{GM}}{\\text{Churn Rate}}, \\quad \\text{E-Comm LTV} = \\text{AOV} \\times \\text{Freq} \\times \\text{Lifespan} \\times \\text{GM}, \\quad \\text{Payback} = \\frac{\\text{CAC}}{\\text{Monthly Margin}}',
  parameters: [
    {
      symbol: '\\text{ARPU / AOV}',
      title: 'Average Revenue Per User / Order',
      description: 'Monthly recurring subscription fee or average order value per transaction.',
      colorClass: 'text-ink',
    },
    {
      symbol: '\\text{Gross Margin (GM)}',
      title: 'Contribution Margin Percentage',
      description: 'Percentage of revenue remaining after direct fulfillment, hosting, and support costs.',
      colorClass: 'text-primary',
    },
    {
      symbol: '\\text{Churn Rate}',
      title: 'Monthly Customer Attrition Rate',
      description: 'Percentage of subscribers canceling services during an average month (Lifespan = 1 / Churn).',
      colorClass: 'text-rose-600',
    },
    {
      symbol: '\\text{CAC}',
      title: 'Customer Acquisition Cost',
      description: 'Total sales and marketing expenditure divided by the number of new customers acquired.',
      colorClass: 'text-amber-600',
    },
  ],
};

const caseStudies = [
  {
    title: 'Case Study 1: B2B Enterprise SaaS Platform (₹50,000 ARPU)',
    tag: 'Enterprise SaaS',
    subtitle: 'Venture-Scale Unit Economics',
    metrics: [
      { label: 'Monthly ARPU', value: '₹50,000 / Account' },
      { label: 'Monthly Churn Rate', value: '1.5% (66.7 Month Lifespan)', colorClass: 'text-emerald-600 font-bold' },
      { label: 'Gross Margin', value: '80.0%' },
      { label: 'Customer Acquisition Cost (CAC)', value: '₹1,20,000 Blended CAC' },
      { label: 'Net Customer LTV', value: '₹26.67 Lakhs / Customer', colorClass: 'text-semantic-success font-black' },
      { label: 'LTV:CAC Ratio & Payback', value: '22.2x LTV:CAC (3.0 Mo Payback)', colorClass: 'text-primary font-bold' },
    ],
    takeaway: 'Low 1.5% enterprise churn coupled with 80% gross margins yields ₹26.67 Lakhs in net lifetime profit per account, enabling the company to aggressively outbid competitors on customer acquisition.',
  },
  {
    title: 'Case Study 2: D2C Consumer Brand Optimizing Repeat Frequency',
    tag: 'E-Commerce LTV',
    subtitle: 'Scaling Repeat Purchases',
    metrics: [
      { label: 'Average Order Value (AOV)', value: '₹2,500 / Order' },
      { label: 'Purchase Frequency', value: '3.5 Orders / Year' },
      { label: 'Customer Lifespan', value: '3.0 Years' },
      { label: 'Gross Margin', value: '60.0%' },
      { label: 'Customer Acquisition Cost (CAC)', value: '₹3,500' },
      { label: 'Net LTV & Unit Ratio', value: '₹15,750 Net LTV (4.5x LTV:CAC)', colorClass: 'text-semantic-success font-black' },
    ],
    takeaway: 'By increasing repeat purchase frequency from 2 to 3.5 orders per year through post-purchase email flows, the D2C brand elevated its LTV:CAC ratio from 2.6x to 4.5x.',
  },
];

const strategies = [
  {
    number: '01',
    title: 'Target a 3.0x to 5.0x LTV:CAC Gold Standard',
    description: 'An LTV:CAC under 3.0x means marketing is consuming too much gross profit. An LTV:CAC above 5.0x indicates you are under-investing in acquisition and leaving market share on the table.',
  },
  {
    number: '02',
    title: 'Prioritize Churn Reduction Over Top-of-Funnel Ads',
    description: 'Halving monthly churn from 4% to 2% doubles your customer lifetime value permanently without increasing marketing expenditure by a single rupee.',
  },
  {
    number: '03',
    title: 'Keep CAC Payback Below 12 Months',
    description: 'Recovering customer acquisition costs within 12 months allows your business to self-fund working capital and recycle cash into new customer acquisition cohorts.',
  },
  {
    number: '04',
    title: 'Introduce Value-Metric Pricing Expansion',
    description: 'Implement seat-based, usage-based, or volume-tiered pricing so ARPU expands automatically as your customers grow, driving Net Revenue Retention (NRR) above 110%.',
  },
];
---

<FlagshipLayout
  data={data}
  slug={slug}
  timelineSteps={timelineSteps}
  targetPersonas={targetPersonas}
  formulaDetails={formulaDetails}
  caseStudies={caseStudies}
  strategies={strategies}
>
  <div slot="calculator">
    <CustomerLifetimeValueCalculatorWidget client:visible />
  </div>
</FlagshipLayout>
