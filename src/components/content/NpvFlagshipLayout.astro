---
import FlagshipLayout from './FlagshipLayout.astro';
import NpvCalculatorWidget from '../calculators/NpvCalculatorWidget';

export interface Props {
  data: any;
  slug: string;
}

const { data, slug } = Astro.props;

const timelineSteps = [
  {
    stepNumber: '01',
    title: 'Input Initial Outlay & Hurdle Rate',
    description: 'Enter your initial capital investment cost (CF0) and your target cost of capital or hurdle discount rate (% p.a.).',
  },
  {
    stepNumber: '02',
    title: 'Project Annual Net Cash Inflows',
    description: 'Add annual net cash flows (CF1 to CFN) generated by the project over its operating lifetime.',
  },
  {
    stepNumber: '03',
    title: 'Evaluate Capital Budgeting Metrics',
    description: 'Analyze Net Present Value (NPV), Internal Rate of Return (IRR), Modified IRR (MIRR), Profitability Index (PI), and Discounted Payback.',
  },
];

const benchmarkCaseStudies = [
  {
    persona: 'Equipment Replacement Project',
    scenario: 'CF0 = ₹10 Lakhs | Hurdle Rate = 10% | 5-Year Savings: ₹3L, ₹3.5L, ₹4L, ₹4.5L, ₹5L',
    recommendation: 'NPV = +₹4,80,326 | IRR = 25.3% | Project creates significant shareholder value (Accept).',
  },
  {
    persona: 'Software R&D Venture',
    scenario: 'CF0 = ₹25 Lakhs | Hurdle Rate = 12% | Scaling SaaS Flows over 5 Years',
    recommendation: 'NPV = +₹19,45,000 | MIRR = 21.4% | Strong positive NPV justifies initial R&D outlay.',
  },
  {
    persona: 'Commercial Real Estate Acquisition',
    scenario: 'CF0 = ₹1 Crore | Hurdle Rate = 9% | Annual Rental Yields + Year 5 Terminal Sale',
    recommendation: 'NPV = +₹26,80,000 | PI = 1.27 | Value-accretive real estate investment opportunity.',
  },
];
---

<FlagshipLayout data={data} slug={slug}>
  <NpvCalculatorWidget client:load />

  {/* Educational Guidance Section */}
  <section class="mt-12 space-y-8 border-t border-hairline pt-8">
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink">
        How to Evaluate Capital Budgeting Projects with NPV & IRR
      </h2>
      <p class="text-sm text-muted leading-relaxed">
        Net Present Value (NPV) and Internal Rate of Return (IRR) are fundamental capital budgeting metrics used by financial analysts and corporate managers to determine whether a project or business investment adds financial value.
      </p>
    </div>

    {/* 3-Step Process Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {timelineSteps.map((step) => (
        <div class="p-6 bg-canvas border border-hairline rounded-2xl space-y-3 shadow-soft">
          <span class="text-xs font-mono font-black px-2.5 py-1 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 rounded-md inline-block">
            Step {step.stepNumber}
          </span>
          <h3 class="text-base font-bold text-ink">{step.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    {/* Benchmark Case Studies */}
    <div class="space-y-4 pt-6 border-t border-hairline">
      <h3 class="text-lg font-bold text-ink">
        Illustrative Capital Allocation Case Studies
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {benchmarkCaseStudies.map((cs) => (
          <div class="p-5 bg-surface-soft border border-hairline rounded-2xl space-y-2">
            <span class="text-xs font-bold text-emerald-600 block">{cs.persona}</span>
            <p class="text-xs font-semibold text-ink">{cs.scenario}</p>
            <p class="text-xs text-muted leading-relaxed">{cs.recommendation}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</FlagshipLayout>
