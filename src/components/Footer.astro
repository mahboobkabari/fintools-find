---
const categoryColumns = [
  {
    title: 'Active Tool Sectors',
    links: [
      { name: 'Loans & EMI (8 Tools)', href: '/tools/loans/' },
      { name: 'Investment & Wealth (6 Tools)', href: '/tools/investment/' },
      { name: 'Tax & Income (7 Tools)', href: '/tools/tax/' },
      { name: 'Retirement (7 Tools)', href: '/tools/retirement/' },
    ],
  },
  {
    title: 'Platform Overview',
    links: [
      { name: 'All 28 Tools Directory', href: '/tools/' },
      { name: 'About FinTool', href: '/about/' },
      { name: 'Contact & Support', href: '/contact/' },
      { name: 'Privacy Policy', href: '/privacy-policy/' },
    ],
  },
  {
    title: 'Governance & Standards',
    links: [
      { name: 'Editorial Policy', href: '/editorial-policy/' },
      { name: 'Calculation Methodology', href: '/methodology/' },
      { name: 'Institutional Sources', href: '/sources/' },
      { name: 'Financial Disclaimer', href: '/disclaimer/' },
    ],
  },
  {
    title: 'Terms & Legal',
    links: [
      { name: 'Terms of Use', href: '/terms/' },
      { name: 'Financial Disclaimer', href: '/disclaimer/' },
      { name: '100% Client Privacy', href: '/privacy-policy/' },
      { name: 'Site Map', href: '/sitemap-index.xml' },
    ],
  },
];
---
<footer class="w-full bg-canvas border-t border-hairline pt-16 pb-8 px-4 md:px-8 mt-24">
  <div class="max-w-[1200px] mx-auto grid grid-cols-2 md:grid-cols-6 gap-8 pb-12 border-b border-hairline">
    <div class="col-span-2">
      <a href="/" class="flex items-center gap-2 text-ink font-sans font-bold text-xl tracking-tight mb-4">
        <span class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-mono text-sm">₹</span>
        <span>FinTool</span>
      </a>
      <p class="text-sm text-body max-w-sm mb-4 leading-relaxed">
        Free, high-speed, ad-supported financial calculator hub. 28 active tools across 4 categories built with institutional accuracy and 100% client-side privacy.
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium text-body">
        <a href="/about/" class="hover:text-primary transition-colors">About Us</a>
        <a href="/contact/" class="hover:text-primary transition-colors">Contact</a>
        <a href="/privacy-policy/" class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-primary transition-colors">Terms of Use</a>
        <a href="/editorial-policy/" class="hover:text-primary transition-colors">Editorial Policy</a>
        <a href="/methodology/" class="hover:text-primary transition-colors">Methodology</a>
        <a href="/sources/" class="hover:text-primary transition-colors">Sources</a>
        <a href="/disclaimer/" class="hover:text-primary transition-colors">Disclaimer</a>
      </div>
    </div>

    {categoryColumns.map((col) => (
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink mb-4">{col.title}</h4>
        <ul class="space-y-2 text-sm text-body">
          {col.links.map((link) => (
            <li><a href={link.href} class="hover:text-primary transition-colors">{link.name}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="max-w-[1200px] mx-auto pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-muted gap-4">
    <p>© {new Date().getFullYear()} FinTool. All calculations are estimates for educational purposes.</p>
    <p>100% Client-Side Computation · Zero User Data Saved</p>
  </div>
</footer>
