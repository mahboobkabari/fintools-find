---
export interface Props {
  roadmap: Array<{
    level: string;
    title: string;
    description: string;
  }>;
}

const { roadmap } = Astro.props;
---

{roadmap && roadmap.length > 0 && (
  <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 space-y-6 shadow-soft">
    <div class="border-b border-hairline pb-4">
      <h3 class="text-xl font-bold font-heading text-ink">Structured Learning Roadmap</h3>
      <p class="text-xs text-muted mt-1">Progressive path from core financial fundamentals to advanced decision tools.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {roadmap.map((step, idx) => (
        <div class="p-5 rounded-2xl bg-surface-strong border border-hairline space-y-2 relative">
          <div class="flex items-center justify-between text-xs font-mono font-bold text-primary">
            <span>STEP 0{idx + 1}</span>
            <span class="px-2 py-0.5 rounded-lg bg-primary/10 border border-primary/20 text-[10px] uppercase">
              {step.level}
            </span>
          </div>
          <h4 class="font-heading font-bold text-sm text-ink">{step.title}</h4>
          <p class="text-xs text-body leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
)}
