---
export interface Props {
  stats: {
    calculators: number;
    guides: number;
    comparisons: number;
  };
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-3 gap-4 max-w-3xl mx-auto">
  <div class="p-4 sm:p-5 rounded-2xl bg-canvas border border-hairline text-center space-y-1 shadow-soft">
    <div class="text-2xl sm:text-3xl font-heading font-extrabold text-primary">{stats.calculators}+</div>
    <div class="text-xs font-mono font-bold text-muted uppercase tracking-wider">Calculators</div>
  </div>
  <div class="p-4 sm:p-5 rounded-2xl bg-canvas border border-hairline text-center space-y-1 shadow-soft">
    <div class="text-2xl sm:text-3xl font-heading font-extrabold text-accent-sky">{stats.guides}+</div>
    <div class="text-xs font-mono font-bold text-muted uppercase tracking-wider">Guides</div>
  </div>
  <div class="p-4 sm:p-5 rounded-2xl bg-canvas border border-hairline text-center space-y-1 shadow-soft">
    <div class="text-2xl sm:text-3xl font-heading font-extrabold text-semantic-success">{stats.comparisons}+</div>
    <div class="text-xs font-mono font-bold text-muted uppercase tracking-wider">Comparisons</div>
  </div>
</div>
