---
export interface Props {
  slotId?: string;
  className?: string;
}

const { slotId = 'default-slot', className = '' } = Astro.props;
---

<div class={`my-8 p-4 bg-surface-soft border border-hairline rounded-md text-center ${className}`}>
  <div class="min-h-[100px] flex items-center justify-center text-xs text-muted font-mono tracking-wide uppercase">
    <span>[ Ad Space · {slotId} ]</span>
  </div>
</div>
